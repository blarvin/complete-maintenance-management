{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
"hooks": {
  "PreToolUse": [
    {
      "matcher": "PowerShell",
      "hooks": [
        {
          "type": "command",
          "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/smart_approve.js\""
        }
      ]
    }
  ]
},
  "plansDirectory": ".claude/plans",
  "permissions": {
    "allow": [
      "Bash(npm run typecheck)",
      "Bash(npm run typecheck *)",
      "Bash(npm run test)",
      "Bash(npm run test *)",
      "mcp__claude-in-chrome__read_page",
      "mcp__claude-in-chrome__read_console_messages",
      "Bash(npm:*)",
      "Bash(npm run:*)",
      "Bash(npx vite:*)",
      "Bash(npx vitest:*)",
      "Bash(npx tsc:*)",
      "Bash(npx cypress:*)",
      "Bash(vitest:*)",
      "Bash(tsc:*)",
      "Bash(node:*)",
      "Bash(git add:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git restore:*)",
      "Bash(git stash:*)",
      "Bash(git branch:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git status)",
      "Bash(git show:*)",
      "Bash(mkdir:*)",
      "Bash(mv:*)",
      "Bash(cp:*)",
      "Bash(touch:*)",
      "Bash(firebase emulators:*)",
      "Edit(src/**)",
      "Edit(tests/**)",
      "Edit(cypress/**)",
      "Bash(find:*)",
      "Bash(echo:*)",
      "Bash(cd:*)",
      "Bash(grep:*)",
      "Bash(xargs:*)",
      "Bash(git ls-tree:*)",
      "Bash(claude mcp:*)",
      "PowerShell(git *)",
      "PowerShell(npm run *)",
      "PowerShell(npm i *)",
      "PowerShell(npm ls *)",
      "PowerShell(Select-String *)",
      "PowerShell(Get-Content *)",
      "PowerShell(Set-Content *)",
      "WebSearch",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:claude.ai)",
      "mcp__context7__resolve-library-id",
      "mcp__context7__query-docs",
      "mcp__jcodemunch__index_folder",
      "mcp__jcodemunch__list_repos",
