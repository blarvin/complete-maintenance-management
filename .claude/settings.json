      "PowerShell(git push)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "PowerShell(firebase deploy *)",
      "PowerShell(netlify deploy *)",
      "PowerShell(Get-Content *.env)",
      "PowerShell(Get-Content *.env.*)"
